generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  applications Application[]
  awards       Award[]
}

model Award {
  id           String        @id @default(cuid())
  name         String
  categoryId   String
  createdAt    DateTime      @default(now())
  applications Application[]
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
}

model Application {
  id                String              @id @default(cuid())
  fullName          String
  email             String
  phone             String
  country           String
  stateProvince     String?
  city              String
  professionalTitle String
  yearsExperience   Int
  membershipNumber  String?
  membershipLevel   String?
  websiteUrl        String?
  socialUrl         String?
  reviewsUrl        String?
  heardAbout        String?
  categoryId        String
  awardId           String
  status            ApplicationStatus   @default(DRAFT)
  paymentStatus     PaymentStatus       @default(PENDING)
  amount            Int                 @default(5000)
  currency          String              @default("usd")
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId  String?        @unique
  paidAt            DateTime?
  submittedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  award             Award               @relation(fields: [awardId], references: [id])
  category          Category            @relation(fields: [categoryId], references: [id])
  answers           ApplicationAnswer[]
  files             ApplicationFile[]
  judgeScores       JudgeScore[]
  payments          Payment[]
}

model JuryApplication {
  id                               String                @id @default(cuid())
  fullName                         String
  email                            String                @unique
  phone                            String
  country                          String
  city                             String
  professionalTitle                String
  yearsExperience                  Int
  employerAffiliation              String
  membershipStatus                 String?
  membershipLevel                  String?
  previousJudgingExperience        Boolean
  previousJudgingDetails           String?
  pastWinner                       Boolean               @default(false)
  pastWinnerYear                   Int?
  expertiseAreas                   String[]
  professionalBio                  String
  professionalWebsite              String?
  conflictDisclosure               String
  confidentialityAgreementAccepted Boolean               @default(false)
  motivation                       String
  ibpaAssociationMember            Boolean               @default(false)
  ibpaNumber                       String?
  status                           JuryApplicationStatus @default(SUBMITTED)
  submittedAt                      DateTime?
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  adminNotes                       String?
  paymentStatus                    PaymentStatus         @default(PENDING)
  approvedAt                       DateTime?
  rejectedAt                       DateTime?
  paidAt                           DateTime?
  stripeCheckoutSessionId          String?               @unique
  files                            JuryApplicationFile[]
  judgeScores                      JudgeScore[]
  account                          JuryAccount?
}

model JuryAccount {
  id                String           @id @default(cuid())
  juryApplicationId String?          @unique
  email             String           @unique
  passwordHash      String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  juryApplication   JuryApplication? @relation(fields: [juryApplicationId], references: [id], onDelete: Cascade)
}

model ApplicationAnswer {
  id            String      @id @default(cuid())
  applicationId String
  fieldKey      String
  valueText     String?
  valueNumber   Int?
  valueBoolean  Boolean?
  valueJson     Json?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model JuryApplicationFile {
  id                String          @id @default(cuid())
  juryApplicationId String
  fieldKey          String
  fileName          String
  mimeType          String
  fileSize          Int
  storageKey        String?
  createdAt         DateTime        @default(now())
  juryApplication   JuryApplication @relation(fields: [juryApplicationId], references: [id], onDelete: Cascade)
}

model ApplicationFile {
  id            String      @id @default(cuid())
  applicationId String
  fieldKey      String
  fileName      String
  fileUrl       String
  mimeType      String
  fileSize      Int
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String        @id @default(cuid())
  applicationId         String
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  amount                Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  application           Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model StripeWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  payloadJson   Json?
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
}

model JudgeScore {
  id            String      @id @default(cuid())
  applicationId String
  judgeId       String
  technical     Int?
  aesthetic     Int?
  creativity    Int?
  impact        Int?
  presentation  Int?
  totalScore    Int?
  comment       String?
  status        ScoreStatus @default(DRAFT)
  submittedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  judge         JuryApplication @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([applicationId, judgeId])
  @@index([applicationId])
  @@index([judgeId])
}

enum ApplicationStatus {
  DRAFT
  PAYMENT_PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum JuryApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum ScoreStatus {
  DRAFT
  SUBMITTED
  REOPENED
}
