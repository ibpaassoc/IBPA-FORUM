generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["forum_next"]
}

// The refactored application is deployed against the isolated `forum_next`
// PostgreSQL schema. The adapter's schema option is set in shared/lib/prisma.ts
// so the legacy public schema remains available for rollback during cutover.

enum DataScope {
  PRODUCTION
  TEST
  DEV

  @@schema("forum_next")
}

enum AccountRole {
  APPLICANT
  JURY

  @@schema("forum_next")
}

enum AccountStatus {
  INVITED
  ACTIVE
  DISABLED

  @@schema("forum_next")
}

enum AccountSetupTokenPurpose {
  SETUP
  PASSWORD_RESET

  @@schema("forum_next")
}

enum NominationStatus {
  DRAFT
  SUBMITTED
  RETURNED_FOR_CHANGES
  UNDER_REVIEW
  SCORED
  WITHDRAWN
  REJECTED
  LOCKED
  ARCHIVED

  @@schema("forum_next")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED

  @@schema("forum_next")
}

enum PaymentPurchaseType {
  NOMINATION
  JURY
  TICKET

  @@schema("forum_next")
}

enum PaymentProvider {
  STRIPE
  MANUAL

  @@schema("forum_next")
}

enum JuryApplicationStatus {
  SUBMITTED
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  REJECTED
  PAID

  @@schema("forum_next")
}

enum JuryReviewStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  LOCKED

  @@schema("forum_next")
}

enum TicketKind {
  FORUM
  APPLICANT
  JURY

  @@schema("forum_next")
}

enum TicketType {
  ONE_DAY
  TWO_DAYS

  @@schema("forum_next")
}

enum TicketStatus {
  PENDING
  PAID
  CANCELED
  CHECKED_ONE_DAY
  CHECKED_TWO_DAY
  CHECKED_GALA_DINNER

  @@schema("forum_next")
}

enum StripeWebhookState {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED

  @@schema("forum_next")
}

enum TestStatus {
  ACTIVE
  COMPLETED
  CLEANED
  FAILED

  @@schema("forum_next")
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  awards      Award[]
  nominations Nomination[]

  @@schema("forum_next")
}

model Award {
  id          String       @id @default(cuid())
  name        String
  categoryId  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  nominations Nomination[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@schema("forum_next")
}

model Account {
  id                           String                    @id @default(cuid())
  email                        String
  normalizedEmail              String
  passwordHash                 String?
  role                         AccountRole
  status                       AccountStatus             @default(INVITED)
  setupTokenHash               String?                   @unique
  setupTokenPurpose            AccountSetupTokenPurpose?
  setupTokenExpiresAt          DateTime?
  setupTokenIssuedAt           DateTime?
  setupTokenUsedAt             DateTime?
  lastSetupEmailSentAt         DateTime?
  lastSetupEmailDeliveryStatus String?
  lastSetupEmailDeliveryError  String?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  dataScope                    DataScope                 @default(PRODUCTION)
  applicantProfile             ApplicantProfile?
  juryApplication              JuryApplication?
  juryProfile                  JuryProfile?
  payments                     Payment[]
  tickets                      Ticket[]

  @@unique([normalizedEmail, role])
  @@index([role, status])
  @@index([normalizedEmail])
  @@index([dataScope, role, status])
  @@schema("forum_next")
}

model ApplicantProfile {
  id                 String       @id @default(cuid())
  accountId          String       @unique
  fullName           String
  phone              String?
  country            String?
  stateProvince      String?
  city               String?
  professionalTitle  String?
  yearsExperience    Int?
  membershipNumber   String?
  membershipLevel    String?
  preferredLocale    String       @default("en")
  websiteUrl         String?
  socialUrl          String?
  reviewsUrl         String?
  deadlineOverrideAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  dataScope          DataScope    @default(PRODUCTION)
  account            Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  nominations        Nomination[]
  tickets            Ticket[]

  @@index([fullName])
  @@index([deadlineOverrideAt])
  @@index([dataScope, createdAt])
  @@schema("forum_next")
}

model JuryApplication {
  id                               String                @id @default(cuid())
  accountId                        String                @unique
  fullName                         String
  email                            String
  phone                            String
  country                          String
  city                             String
  professionalTitle                String
  yearsExperience                  Int
  employerAffiliation              String
  membershipStatus                 String?
  membershipLevel                  String?
  previousJudgingExperience        Boolean
  previousJudgingDetails           String?
  pastWinner                       Boolean               @default(false)
  pastWinnerYear                   Int?
  expertiseAreas                   String[]
  professionalBio                  String
  professionalWebsite              String?
  conflictDisclosure               String
  motivation                       String
  ibpaAssociationMember            Boolean               @default(false)
  ibpaNumber                       String?
  status                           JuryApplicationStatus @default(SUBMITTED)
  informationRequestTokenHash      String?               @unique
  informationRequestTokenExpiresAt DateTime?
  informationRequests              Json
  files                            Json
  submittedAt                      DateTime?
  approvedAt                       DateTime?
  rejectedAt                       DateTime?
  adminNotes                       String?
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  dataScope                        DataScope             @default(PRODUCTION)
  account                          Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  profile                          JuryProfile?
  payments                         Payment[]

  @@index([dataScope, status])
  @@index([email])
  @@schema("forum_next")
}

model JuryProfile {
  id                  String                 @id @default(cuid())
  accountId           String                 @unique
  juryApplicationId   String                 @unique
  fullName            String
  phone               String?
  country             String?
  city                String?
  professionalTitle   String?
  yearsExperience     Int?
  employerAffiliation String?
  expertiseAreas      String[]
  approvedCategories  String[]               @default([])
  professionalBio     String?
  professionalWebsite String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  dataScope           DataScope              @default(PRODUCTION)
  account             Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  juryApplication     JuryApplication        @relation(fields: [juryApplicationId], references: [id], onDelete: Restrict)
  reviews             JuryNominationReview[]

  @@index([dataScope, createdAt])
  @@schema("forum_next")
}

model Nomination {
  id                 String                 @id @default(cuid())
  applicantProfileId String
  paymentId          String
  awardId            String
  categoryId         String
  status             NominationStatus       @default(DRAFT)
  revision           Int                    @default(1)
  answers            Json
  files              Json
  scoringSchema      Json
  submittedAt        DateTime?
  scoresReleasedAt   DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  dataScope          DataScope              @default(PRODUCTION)
  applicantProfile   ApplicantProfile       @relation(fields: [applicantProfileId], references: [id], onDelete: Restrict)
  payment            Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  award              Award                  @relation(fields: [awardId], references: [id], onDelete: Restrict)
  category           Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviews            JuryNominationReview[]

  @@index([applicantProfileId, createdAt])
  @@index([paymentId])
  @@index([awardId])
  @@index([categoryId])
  @@index([status])
  @@index([submittedAt])
  @@index([dataScope, status])
  @@schema("forum_next")
}

model JuryNominationReview {
  id            String           @id @default(cuid())
  nominationId  String
  juryProfileId String
  status        JuryReviewStatus @default(NOT_STARTED)
  scoreData     Json?
  totalScore    Decimal?
  comments      String?
  startedAt     DateTime?
  submittedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  dataScope     DataScope        @default(PRODUCTION)
  nomination    Nomination       @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  juryProfile   JuryProfile      @relation(fields: [juryProfileId], references: [id], onDelete: Restrict)

  @@unique([nominationId, juryProfileId])
  @@index([juryProfileId, status])
  @@index([nominationId])
  @@index([dataScope, status])
  @@schema("forum_next")
}

model Payment {
  id                      String              @id @default(cuid())
  accountId               String?
  juryApplicationId       String?
  customerEmail           String
  amount                  Int
  currency                String              @default("usd")
  status                  PaymentStatus       @default(PENDING)
  purchaseType            PaymentPurchaseType
  provider                PaymentProvider
  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId   String?             @unique
  stripeCustomerId        String?
  pricingSnapshot         Json?
  promotionSnapshot       Json?
  refundSnapshot          Json?
  paidAt                  DateTime?
  fulfilledAt             DateTime?
  refundedAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  dataScope               DataScope           @default(PRODUCTION)
  account                 Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  juryApplication         JuryApplication?    @relation(fields: [juryApplicationId], references: [id], onDelete: Restrict)
  nominations             Nomination[]
  tickets                 Ticket[]
  webhookEvents           StripeWebhook[]

  @@index([accountId, status])
  @@index([customerEmail])
  @@index([purchaseType, status])
  @@index([juryApplicationId])
  @@index([dataScope, purchaseType, status])
  @@schema("forum_next")
}

model Ticket {
  id                    String            @id @default(cuid())
  accountId             String?
  applicantProfileId    String?
  paymentId             String?
  kind                  TicketKind        @default(FORUM)
  secureToken           String            @unique
  credential            Json
  activity              Json
  revision              Int               @default(1)
  fullName              String
  email                 String
  phone                 String
  instagram             String?
  type                  TicketType?
  galaDinner            Boolean           @default(false)
  isIbpaMember          Boolean           @default(false)
  ibpaCertNumber        String?
  specialPacketId       String?
  specialPacketPosition Int?
  status                TicketStatus      @default(PENDING)
  paidAt                DateTime?
  lastCheckIn           DateTime?
  forumCheckInAt        DateTime?
  dayOneCheckInAt       DateTime?
  dayTwoCheckInAt       DateTime?
  galaCheckInAt         DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  dataScope             DataScope         @default(PRODUCTION)
  account               Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  applicantProfile      ApplicantProfile? @relation(fields: [applicantProfileId], references: [id], onDelete: SetNull)
  payment               Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([applicantProfileId])
  @@index([paymentId])
  @@index([email])
  @@index([specialPacketId])
  @@index([kind, status])
  @@index([dataScope, status, createdAt])
  @@schema("forum_next")
}

model StripeWebhook {
  id            String             @id @default(cuid())
  eventId       String             @unique
  eventType     String
  payload       Json
  state         StripeWebhookState @default(RECEIVED)
  attempts      Int                @default(0)
  error         String?
  paymentId     String?
  createdAt     DateTime           @default(now())
  lastAttemptAt DateTime?
  processedAt   DateTime?
  payment       Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@index([paymentId])
  @@schema("forum_next")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@schema("forum_next")
}

model Test {
  id              String     @id @default(cuid())
  name            String
  kind            String
  description     String?
  status          TestStatus @default(ACTIVE)
  configuration   Json
  createdRecords  Json
  auditEvents     Json
  emailDeliveries Json
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([kind, createdAt])
  @@index([status, createdAt])
  @@schema("forum_next")
}
